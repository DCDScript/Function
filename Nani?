local Secrets = {}

function Secrets.get()
    local flakes = os.getenv("FLAKES")
    local motion = os.getenv("MOTION")

    if not flakes or flakes == "" then
        error("FLAKES env var is missing. Did you set FLAKES in workflow env?")
    end

    if not motion or motion == "" then
        error("MOTION env var is missing. Did you set MOTION in workflow env?")
    end

    return flakes, motion
end

function Secrets.getTable()
    local flakes, motion = Secrets.get()
    return {
        FLAKES = flakes,
        MOTION = motion
    }
end

return Secrets
